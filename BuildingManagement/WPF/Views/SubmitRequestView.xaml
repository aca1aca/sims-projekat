<UserControl x:Class="Sims.BuildingManagement.WPF.Views.SubmitRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="6" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Podnošenje zahteva za pristup stanu" FontSize="16" FontWeight="Bold" />

        <Grid Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Zgrada" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Buildings}"
                      SelectedItem="{Binding SelectedBuilding}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Code, Mode=OneWay}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Address, Mode=OneWay}" />
                            <Run Text=", " />
                            <Run Text="{Binding Neighborhood, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Broj stana" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ApartmentNumberText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel Orientation="Horizontal">
            <Button Content="Proveri stan" Command="{Binding CheckApartmentCommand}" />
            <Button Content="Potvrdi kreiranje zahteva" Command="{Binding ConfirmCommand}" />
            <Button Content="Odustani" Command="{Binding CancelCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding Warning}" Foreground="#B36B00" TextWrapping="Wrap" Margin="4,10,4,0" />
        <TextBlock Text="{Binding Message}" Foreground="#1B7F3B" TextWrapping="Wrap" Margin="4,4" />
    </StackPanel>
</UserControl>
