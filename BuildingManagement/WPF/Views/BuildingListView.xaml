<UserControl x:Class="Sims.BuildingManagement.WPF.Views.BuildingListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="6">
        <TextBlock DockPanel.Dock="Top" Text="Sve zgrade" FontSize="16" FontWeight="Bold" />
        <CheckBox DockPanel.Dock="Top" Margin="4,8" Content="Sortiraj po broju spratova"
                  IsChecked="{Binding SortByFloorCount}" />

        <DataGrid ItemsSource="{Binding Buildings}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Šifra" Binding="{Binding Code}" Width="80" />
                <DataGridTextColumn Header="Adresa" Binding="{Binding Address}" Width="*" />
                <DataGridTextColumn Header="Naselje" Binding="{Binding Neighborhood}" Width="*" />
                <DataGridTextColumn Header="Grad" Binding="{Binding City}" Width="*" />
                <DataGridTextColumn Header="Država" Binding="{Binding Country}" Width="*" />
                <DataGridTextColumn Header="Broj spratova" Binding="{Binding FloorCount}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
