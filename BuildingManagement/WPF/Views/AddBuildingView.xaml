<UserControl x:Class="Sims.BuildingManagement.WPF.Views.AddBuildingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="6" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Unos zgrade" FontSize="16" FontWeight="Bold" />
        <TextBlock TextWrapping="Wrap" Margin="4,6"
                   Text="Zgrada se kreira u statusu „čeka odobrenje“. Vidljiva je ostalima tek kada je odobri upravnik čiji je JMBG unet." />

        <Grid Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Šifra" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ulica" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Broj" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Naselje" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Neighborhood, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Grad" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Država" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Broj spratova" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding FloorCountText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="JMBG upravnika" />
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ManagerJmbg, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Button Content="Unesi zgradu" HorizontalAlignment="Left" Command="{Binding AddCommand}" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Feedback}" />
    </StackPanel>
</UserControl>
