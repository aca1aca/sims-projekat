<Window x:Class="Sims.BuildingManagement.WPF.Views.RegisterTenantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registracija stanara" Height="420" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Unesite podatke za nalog stanara"
                   FontWeight="Bold" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="JMBG" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Jmbg, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Email" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Lozinka" />
        <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ime" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Prezime" />
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Mobilni telefon" />
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding MobilePhone, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#1B7F3B" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="#B00020" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Zatvori" Click="Close_Click" />
            <Button Content="Registruj se" IsDefault="True" Command="{Binding RegisterCommand}" />
        </StackPanel>
    </Grid>
</Window>
