<UserControl x:Class="Sims.BuildingManagement.WPF.Views.TenantRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="6">
        <TextBlock DockPanel.Dock="Top" Text="Moji zahtevi" FontSize="16" FontWeight="Bold" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8">
            <TextBlock Text="Filter po statusu" />
            <ComboBox Width="180" ItemsSource="{Binding StatusFilters}"
                      DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding StatusFilter}" />
            <Button Content="Povuci zahtev" Command="{Binding WithdrawCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Foreground="#1B7F3B" Margin="4" />

        <DataGrid ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Šifra zgrade" Binding="{Binding BuildingCode}" Width="110" />
                <DataGridTextColumn Header="Broj stana" Binding="{Binding ApartmentNumber}" Width="90" />
                <DataGridTextColumn Header="Datum kreiranja" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy. HH:mm}" Width="140" />
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status, Converter={StaticResource StatusText}}" Width="130" />
                <DataGridTextColumn Header="Razlog odbijanja" Binding="{Binding RejectionReason}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
