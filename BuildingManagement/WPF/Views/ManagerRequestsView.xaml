<UserControl x:Class="Sims.BuildingManagement.WPF.Views.ManagerRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="6">
        <TextBlock DockPanel.Dock="Top" Text="Zahtevi za pristup mojim zgradama" FontSize="16" FontWeight="Bold" />

        <Grid DockPanel.Dock="Top" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Zgrada" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Buildings}"
                      SelectedItem="{Binding SelectedBuilding}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Code, Mode=OneWay}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Address, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Filter" />
            <ComboBox Grid.Row="1" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                      ItemsSource="{Binding StatusFilters}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding StatusFilter}" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Razlog odbijanja" Width="120" />
                <TextBox Width="360" HorizontalAlignment="Left"
                         Text="{Binding RejectionReason, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Potvrdi zahtev" Command="{Binding ApproveCommand}" />
                <Button Content="Odbij zahtev" Command="{Binding RejectCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" Foreground="#1B7F3B" Margin="4" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="JMBG stanara" Binding="{Binding TenantJmbg}" Width="150" />
                <DataGridTextColumn Header="Broj stana" Binding="{Binding ApartmentNumber}" Width="90" />
                <DataGridTextColumn Header="Datum kreiranja" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy. HH:mm}" Width="140" />
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status, Converter={StaticResource StatusText}}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
