<Window x:Class="Sims.BuildingManagement.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sims.BuildingManagement.WPF.ViewModels"
        xmlns:views="clr-namespace:Sims.BuildingManagement.WPF.Views"
        Title="Sistem za upravljanje pristupom zgradama" Height="620" Width="960"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:BuildingListViewModel}">
            <views:BuildingListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BuildingSearchViewModel}">
            <views:BuildingSearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubmitRequestViewModel}">
            <views:SubmitRequestView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TenantRequestsViewModel}">
            <views:TenantRequestsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManagerBuildingsViewModel}">
            <views:ManagerBuildingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManagerRequestsViewModel}">
            <views:ManagerRequestsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddApartmentViewModel}">
            <views:AddApartmentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegisterManagerViewModel}">
            <views:RegisterManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddBuildingViewModel}">
            <views:AddBuildingView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F3B57" Padding="14,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text=" — " Foreground="#B9C7D6" />
                    <TextBlock Text="{Binding RoleText}" Foreground="#B9C7D6" FontSize="14" />
                </StackPanel>
                <Button Content="Odjava" HorizontalAlignment="Right" Command="{Binding SignOutCommand}" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left" Width="220" Background="#EEF1F5" BorderBrush="#D5DBE2" BorderThickness="0,0,1,0">
            <ItemsControl ItemsSource="{Binding MenuItems}" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" Command="{Binding OpenCommand}"
                                HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                Margin="2" Padding="10,8" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <ContentControl Content="{Binding CurrentViewModel}" Margin="6" />
    </DockPanel>
</Window>
