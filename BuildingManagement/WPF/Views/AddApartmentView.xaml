<UserControl x:Class="Sims.BuildingManagement.WPF.Views.AddApartmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="6" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Unos stana" FontSize="16" FontWeight="Bold" />

        <Grid Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Zgrada" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Buildings}"
                      SelectedItem="{Binding SelectedBuilding}" DisplayMemberPath="Code" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Broj stana" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Opis (kvadratura, struktura)" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Broj soba" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RoomCountText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Maksimalan broj stanara" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaxTenantCountText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Button Content="Dodaj stan" HorizontalAlignment="Left" Command="{Binding AddCommand}" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Feedback}" />
    </StackPanel>
</UserControl>
