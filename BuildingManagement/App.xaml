<Application x:Class="Sims.BuildingManagement.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Sims.BuildingManagement.WPF.Converters">
    <Application.Resources>
        <conv:StatusTextConverter x:Key="StatusText" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="TextBlock" x:Key="Feedback">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4,8" />
            <Setter Property="Foreground" Value="#1B7F3B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="#B00020" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="4,4,4,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="4" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
        </Style>
    </Application.Resources>
</Application>
